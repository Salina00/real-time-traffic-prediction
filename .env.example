# TomTom API Key (Get free key from https://developer.tomtom.com/)
TOMTOM_API_KEY=Pm3azetzGlcMsYBx4wDJrE6TUCJgUP5O

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=pune-traffic-raw

# Producer Polling Settings
COLLECTION_INTERVAL_SECONDS=300

# Data Mode: 'tomtom' (calls live API) or 'demo' (generates realistic live events without API key)
DATA_MODE=tomtom

# Spark Checkpoint and Storage Paths
SPARK_CHECKPOINT_DIR=data/processed/checkpoints
PROCESSED_DATA_DIR=data/processed
DEMO_DATA_DIR=data/demo
RAW_DATA_DIR=data/raw
